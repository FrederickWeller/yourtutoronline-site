# Redirects from the old TutorBird-hosted page addresses (and clean,
# extensionless addresses) to the pages on the hand-coded site.
# mod_rewrite (supported by Hostinger's LiteSpeed server); patterns are
# anchored so /terms never matches /terms.html.

RewriteEngine On

RewriteRule ^free-intro-booking/?$     /free-intro.html [R=301,L,NC]
RewriteRule ^free-intro/?$             /free-intro.html [R=301,L,NC]
RewriteRule ^home/?$                   /                [R=301,L,NC]
RewriteRule ^about-us/?$               /about.html      [R=301,L,NC]
RewriteRule ^about/?$                  /about.html      [R=301,L,NC]
RewriteRule ^our-topics/?$             /subjects.html   [R=301,L,NC]
RewriteRule ^topics/?$                 /subjects.html   [R=301,L,NC]
RewriteRule ^subjects/?$               /subjects.html   [R=301,L,NC]
RewriteRule ^contact-us/?$             /contact.html    [R=301,L,NC]
RewriteRule ^contact/?$                /contact.html    [R=301,L,NC]
RewriteRule ^privacy-policy/?$         /privacy.html    [R=301,L,NC]
RewriteRule ^privacy/?$                /privacy.html    [R=301,L,NC]
RewriteRule ^terms/?$                  /terms.html      [R=301,L,NC]
RewriteRule ^terms-and-conditions/?$   /terms.html      [R=301,L,NC]
RewriteRule ^pricing/?$                /pricing.html    [R=301,L,NC]
RewriteRule ^videos/?$                 /videos.html     [R=301,L,NC]
RewriteRule ^login/?$                  /login.html      [R=301,L,NC]
