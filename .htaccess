# Redirects from the old TutorBird-hosted page addresses (and clean,
# extensionless addresses) to the pages on the hand-coded site.
# RedirectMatch with ^...$ anchors so /terms never matches /terms.html.

RedirectMatch 301 ^/free-intro-booking/?$ /free-intro.html
RedirectMatch 301 ^/free-intro/?$         /free-intro.html
RedirectMatch 301 ^/home/?$               /
RedirectMatch 301 ^/about-us/?$           /about.html
RedirectMatch 301 ^/about/?$              /about.html
RedirectMatch 301 ^/our-topics/?$         /subjects.html
RedirectMatch 301 ^/topics/?$             /subjects.html
RedirectMatch 301 ^/subjects/?$           /subjects.html
RedirectMatch 301 ^/contact-us/?$         /contact.html
RedirectMatch 301 ^/contact/?$            /contact.html
RedirectMatch 301 ^/privacy-policy/?$     /privacy.html
RedirectMatch 301 ^/privacy/?$            /privacy.html
RedirectMatch 301 ^/terms/?$              /terms.html
RedirectMatch 301 ^/terms-and-conditions/?$ /terms.html
RedirectMatch 301 ^/pricing/?$            /pricing.html
RedirectMatch 301 ^/videos/?$             /videos.html
RedirectMatch 301 ^/login/?$              /login.html
